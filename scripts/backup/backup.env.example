# Mẫu cấu hình backup. Sao chép thành /etc/cbs-elearning-backup/backup.env, chmod 600.
# File này vừa được script đọc (shell), vừa được nạp vào container restic, nên:
#   - mỗi dòng dạng KEY=value, không dấu nháy, không khoảng trắng, không ký tự $;
#   - đường dẫn bắt đầu bằng /secrets/ là đường dẫn trong container, trỏ tới chính thư mục
#     /etc/cbs-elearning-backup trên máy chủ.

# ---- Kho restic: Google Cloud Storage (docs/backup-gcs.vi.md) ----
RESTIC_REPOSITORY=gs:cbs-elearning-backup:/restic
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs-key.json

# ---- Kho restic: Garage (docs/backup-garage.vi.md) ----
# Khi chuyển sang Garage: thêm # vào 3 dòng GCS ở trên, bỏ dấu # ở 5 dòng dưới.
# RESTIC_REPOSITORY=s3:https://backup-server.internal:3900/cbs-elearning-backup
# AWS_ACCESS_KEY_ID=GK-key-id-cua-key-cbs-backup
# AWS_SECRET_ACCESS_KEY=thay-bang-secret-key-cua-key-cbs-backup
# AWS_DEFAULT_REGION=garage
# RESTIC_CACERT=/secrets/garage-ca.crt

# Mật khẩu mã hóa kho restic. MẤT FILE NÀY LÀ MẤT TOÀN BỘ BẢN BACKUP.
RESTIC_PASSWORD_FILE=/secrets/restic-password

# ---- Script ----
APP_ENV_FILE=/opt/cbs_elearning/.env.production
BACKUP_STAGING_DIR=/var/backups/cbs-elearning/staging
BACKUP_RESTORE_DIR=/var/backups/cbs-elearning/restore
# Để trống nếu không chạy profile chatbot.
QDRANT_BACKUP_URL=http://127.0.0.1:6333
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_CHECK_SUBSET=5%
# Tùy chọn: URL nhận ping khi backup xong (healthchecks.io, Uptime Kuma...). Thêm /start, /fail.
BACKUP_HEALTHCHECK_URL=
