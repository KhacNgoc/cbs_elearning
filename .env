POSTGRES_DB=coretraining
POSTGRES_USER=coretraining
POSTGRES_PASSWORD=change-this-before-production

# pgAdmin Config
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Ollama Config
OLLAMA_HOST=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_REWRITE_MODEL=qwen3:4b
OLLAMA_SUMMARY_MODEL=qwen3:4b
OLLAMA_QUIZ_MODEL=qwen3:4b
# Increase this only when the inference server can execute requests in parallel.
QUIZ_GENERATION_CONCURRENCY=2
QUIZ_GENERATION_MAX_ATTEMPTS=2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# RAG Service Config
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434
EMBEDDING_BATCH_SIZE=32
RAG_SCORE_THRESHOLD=0.55
RAG_TOP_K=5
RAG_CANDIDATE_LIMIT=20
RAG_CONTEXT_MAX_CHARS=10000
OLLAMA_CHAT_TIMEOUT_SECONDS=180
OLLAMA_REWRITE_TIMEOUT_SECONDS=45
OLLAMA_QUERY_EMBEDDING_TIMEOUT_SECONDS=30
OLLAMA_SUMMARY_TIMEOUT_SECONDS=30

# Backend Config
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/
SPRING_APPLICATION_NAME=cbs-elearning-backend
SPRING_PROFILES_ACTIVE=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/coretraining
SPRING_DATASOURCE_USERNAME=coretraining
SPRING_DATASOURCE_PASSWORD=change-this-before-production
MAX_UPLOAD_SIZE=10MB
DOCUMENT_STORAGE_PATH=/app/uploads/documents
VIDEO_STORAGE_PATH=/app/uploads/videos
VIDEO_ACCESS_SECRET=some-long-video-access-secret-for-signing-video-access-key
VIDEO_ACCESS_DURATION_SECONDS=3600
JWT_SECRET=some-long-jwt-signing-secret-key-at-least-64-characters-long-key-1234567890
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATA_INITIALIZER_ENABLED=true
APP_RAG_URL=http://rag-service:8001
RAG_RECENT_MESSAGE_LIMIT=10
RAG_RECENT_CHARACTER_LIMIT=2000
RAG_SUMMARY_MESSAGE_THRESHOLD=5
RAG_SUMMARY_CHARACTER_THRESHOLD=1000
RAG_CONNECT_TIMEOUT_MS=300000
RAG_READ_TIMEOUT_MS=300000
APP_UPLOAD_DIRECTORY=/app/uploads
LOG_PATH=/app/logs
LOG_LEVEL=INFO

# Frontend Config
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK_API=false
VITE_RAG_CHAT_TIMEOUT_MS=330000

