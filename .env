POSTGRES_DB=coretraining
POSTGRES_USER=coretraining
POSTGRES_PASSWORD=change-this-before-production
# Use qwen3:8b on machines with sufficient RAM/VRAM; default 4b is friendlier for development.
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Number of chunks per Ollama embedding request (recommended: 20–50).
EMBEDDING_BATCH_SIZE=32
