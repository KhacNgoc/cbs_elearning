# =============================================================================
# CoreTraining frontend (Vite)
# =============================================================================
# Public URL of the backend, for example: https://api.example.com
# Empty uses the frontend origin and its /api/ Nginx proxy.
VITE_API_URL=
VITE_USE_MOCK_API=false
VITE_RAG_CHAT_TIMEOUT_MS=65000
VITE_QUIZ_GENERATION_TIMEOUT_MS=300000

# =============================================================================
# PostgreSQL and pgAdmin
# =============================================================================
POSTGRES_DB=coretraining
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=123

# Spring Boot datasource configuration (standalone and Docker Compose).
SPRING_PROFILES_ACTIVE=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/coretraining
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# =============================================================================
# CoreTrainingAPI
# =============================================================================
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/
SPRING_APPLICATION_NAME=coretraining

MAX_UPLOAD_SIZE=500MB

# Comma-separated public frontend origins, for example: https://example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
JWT_EXPIRATION_MS=86400000

# Required in production. Use long, cryptographically random and different keys.
JWT_SECRET=thisIsAVerySecretKeyYouWillNotKnow
VIDEO_ACCESS_SECRET=thisIsASecondVerySecretKeyYouWillNotKnow
VIDEO_ACCESS_DURATION_SECONDS=3600

DOCUMENT_STORAGE_PATH=/app/uploads/documents
VIDEO_STORAGE_PATH=/app/uploads/videos
APP_UPLOAD_DIRECTORY=/app/uploads
APP_RAG_URL=http://rag-service:8001

DATA_INITIALIZER_ENABLED=true

RAG_RECENT_MESSAGE_LIMIT=8
RAG_RECENT_CHARACTER_LIMIT=12000
RAG_SUMMARY_MESSAGE_THRESHOLD=12
RAG_SUMMARY_CHARACTER_THRESHOLD=24000
RAG_CONNECT_TIMEOUT_MS=5000
RAG_READ_TIMEOUT_MS=60000
RAG_QUIZ_READ_TIMEOUT_MS=300000
RAG_SUMMARY_TIMEOUT_MS=20000

LOG_PATH=logs
LOG_LEVEL=INFO

# =============================================================================
# rag-service, Qdrant and Ollama
# =============================================================================
# These are Docker network URLs. Replace them when services run outside Compose.
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434
OLLAMA_HOST=http://ollama:11434

OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_QUIZ_MODEL=qwen3:1.7b
OLLAMA_REWRITE_MODEL=qwen3:4b
OLLAMA_SUMMARY_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

EMBEDDING_BATCH_SIZE=32
RAG_SCORE_THRESHOLD=0.55
RAG_TOP_K=2
RAG_CANDIDATE_LIMIT=25
RAG_CONTEXT_MAX_CHARS=2400
RAG_COURSE_SUMMARY_TOP_K=5
RAG_COURSE_SUMMARY_CONTEXT_MAX_CHARS=6500
RAG_COURSE_SUMMARY_NUM_PREDICT=256

OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192
OLLAMA_CHAT_NUM_PREDICT=192
OLLAMA_REWRITE_NUM_PREDICT=96
OLLAMA_SUMMARY_NUM_PREDICT=192

OLLAMA_CHAT_TIMEOUT_SECONDS=50
OLLAMA_REWRITE_TIMEOUT_SECONDS=10
OLLAMA_QUERY_EMBEDDING_TIMEOUT_SECONDS=10
OLLAMA_SUMMARY_TIMEOUT_SECONDS=20

OLLAMA_QUIZ_GENERATION_TIMEOUT_SECONDS=120
OLLAMA_QUIZ_VERIFICATION_TIMEOUT_SECONDS=60
QUIZ_LLM_VERIFICATION_ENABLED=false
QUIZ_RETRIEVAL_LIMIT=5
QUIZ_RETRIEVAL_CANDIDATE_LIMIT=12
QUIZ_CONTEXT_MAX_CHARS=5000
QUIZ_SOURCE_MAX_CHARS=650
QUIZ_GENERATION_CONCURRENCY=2
QUIZ_GENERATION_MAX_ATTEMPTS=2
QUIZ_NUM_CTX=2048
QUIZ_SINGLE_NUM_PREDICT=180
QUIZ_MULTIPLE_NUM_PREDICT=220
